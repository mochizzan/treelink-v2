# =============================================================================
# Project dotfiles
# =============================================================================
# Shared configuration such as .gitignore and .oxlintrc.json stays tracked.
# A blanket ".*" rule would silently ignore those too, so generated
# dot-prefixed artifacts are listed explicitly below.

# =============================================================================
# Dependencies and build output
# =============================================================================
node_modules/
dist/
dist-ssr/
build/
out/
.output/
.vite/
.vite-inspect/
.turbo/
.parcel-cache/
.next/
.nuxt/
.svelte-kit/
.astro/
.angular/
.docusaurus/
.vercel/
.netlify/
.serverless/
.firebase/
.sanity/
.contentlayer/
.expo/
.expo-shared/
.webpack/
.rollup.cache/
.esbuild/
.swc/
*.tsbuildinfo
*.local

# =============================================================================
# Logs, caches, and process files
# =============================================================================
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*
.eslintcache
.stylelintcache
.oxlintcache
.sass-cache/
.cache/
.tmp/
.temp/
.history/
.npm/
.pnpm-store/
.yarn/
.nyc_output/
.node_repl_history
*.pid
*.pid.lock
*.seed
*.stackdump

# =============================================================================
# Environment and secrets
# =============================================================================
.env
.env.*
!.env.example
!.env.sample
!.env.template

